---
// Contact section with a form connected to Zubmit
---

<section id="contact" class="relative py-24 md:py-32 overflow-hidden border-t border-white/5">
  <div class="absolute inset-0 bg-grid z-0 pointer-events-none"></div>
  
  <div class="relative z-10 max-w-6xl mx-auto px-6">
    <div class="max-w-3xl mx-auto">
      <div class="mb-12 text-center">
        <h2 class="text-3xl md:text-5xl font-medium text-white tracking-tight mb-4 animate-on-scroll">
          ¿Tienes un proyecto en mente?
        </h2>
        <p class="text-neutral-400 text-lg max-w-xl mx-auto animate-on-scroll delay-100">
          Envíame un mensaje y hablemos de cómo puedo ayudarte a construir tu próxima gran idea.
        </p>
      </div>

      <div class="bg-white/[0.02] border border-white/10 rounded-2xl p-8 md:p-10 backdrop-blur-sm animate-on-scroll delay-200">
        <form id="contact-form" action="https://zuby.zubmit.net/14da9435-55bf-4002-9c93-0b44b7f847d6" method="POST" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="name" class="block text-sm font-medium text-neutral-300">Nombre completo</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                placeholder="Tu nombre" 
                required 
                class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white placeholder-neutral-500 focus:outline-none focus:ring-2 focus:ring-white/20 focus:border-transparent transition-all"
              />
            </div>
            
            <div class="space-y-2">
              <label for="email" class="block text-sm font-medium text-neutral-300">Correo electrónico</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="tu@email.com" 
                required 
                class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white placeholder-neutral-500 focus:outline-none focus:ring-2 focus:ring-white/20 focus:border-transparent transition-all"
              />
            </div>
          </div>

          <div class="space-y-2">
            <label for="message" class="block text-sm font-medium text-neutral-300">Mensaje o detalles del proyecto</label>
            <textarea 
              id="message" 
              name="message" 
              rows="5" 
              placeholder="¿En qué puedo ayudarte?" 
              required
              class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white placeholder-neutral-500 focus:outline-none focus:ring-2 focus:ring-white/20 focus:border-transparent transition-all resize-none"
            ></textarea>
          </div>

          <!-- Anti-spam honeypot (optional, usually good practice but let's keep it simple with Zubmit) -->
          <input type="hidden" name="_gotcha" class="hidden" />

          <button 
            type="submit"
            id="submit-button"
            class="w-full group relative px-6 py-4 bg-white text-black text-sm font-medium rounded-xl overflow-hidden transition-all hover:bg-neutral-200 disabled:opacity-70 disabled:cursor-not-allowed"
          >
            <span class="relative z-10 flex items-center justify-center gap-2">
              <span id="button-text">Enviar Mensaje</span>
              <span id="button-icon" class="iconify" data-icon="lucide:send" data-width="16"></span>
            </span>
          </button>

          <div id="form-success" class="hidden p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-400 text-sm text-center">
            ¡Mensaje enviado con éxito! Te responderé lo antes posible.
          </div>
          <div id="form-error" class="hidden p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm text-center">
            Hubo un error al enviar el mensaje. Por favor, inténtalo de nuevo.
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
  const buttonText = document.getElementById('button-text');
  const successMessage = document.getElementById('form-success');
  const errorMessage = document.getElementById('form-error');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Reset state
      successMessage?.classList.add('hidden');
      errorMessage?.classList.add('hidden');
      
      // Loading state
      if (submitButton) submitButton.disabled = true;
      if (buttonText) buttonText.textContent = 'Enviando...';
      
      const formData = new FormData(form);
      
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });
        
        if (response.ok) {
          successMessage?.classList.remove('hidden');
          form.reset();
        } else {
          errorMessage?.classList.remove('hidden');
        }
      } catch (error) {
        errorMessage?.classList.remove('hidden');
      } finally {
        // Reset button
        if (submitButton) submitButton.disabled = false;
        if (buttonText) buttonText.textContent = 'Enviar Mensaje';
      }
    });
  }
</script>
